# Postgres (Railway provides this automatically when you add a Postgres service)
DATABASE_URL="postgresql://user:password@localhost:5432/haze_wholesale"

# Order Time API — use the dedicated portal user, never a person's login
ORDERTIME_API_KEY=""
ORDERTIME_EMAIL=""
ORDERTIME_PASSWORD=""
# Only stock at this Order Time location is sellable on the portal
ORDERTIME_STOCK_LOCATION="HQ"

# Public address of the portal (used in sign-in and invite links)
APP_URL="https://wholesale.thehazeconnect.com"
# 32+ random characters; signs session cookies
SESSION_SECRET=""
# Comma-separated emails that get an admin login on first sign-in
ADMIN_EMAILS="alex@thehazeconnect.com"

# Email via Google Workspace SMTP (create an app password for the sending mailbox)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="wholesale@thehazeconnect.com"
SMTP_PASSWORD=""
MAIL_FROM="Haze Wholesale <wholesale@thehazeconnect.com>"

# Card processing fee added to card orders (percent)
CARD_FEE_PERCENT="3"

# Authorize.net (checkout phase)
AUTHNET_API_LOGIN_ID=""
AUTHNET_TRANSACTION_KEY=""
AUTHNET_CLIENT_KEY=""
AUTHNET_ENV="sandbox"
