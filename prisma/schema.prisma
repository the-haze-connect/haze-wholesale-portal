// Haze Wholesale Portal data model.
// Order Time stays the system of record for items, stock, customers and orders;
// these tables cache what the portal needs and hold what Order Time doesn't
// (logins, announcements, commission ledger).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PriceLevelKind {
  BASE // no discount
  PERCENT_OFF // Tier 2 (5%), Tier 3 (10%)
  ITEM_PRICE // Distro 1, Distro 2, Master Distro, Master Distro TB
}

enum TierGroup {
  RETAIL // base price, Tier 2, Tier 3  -> 10% commission
  DISTRO // Distro levels               -> 8% commission
}

model PriceLevel {
  id         Int            @id @default(autoincrement())
  otId       Int            @unique
  name       String
  kind       PriceLevelKind
  percentOff Decimal?       @db.Decimal(5, 2)
  tierGroup  TierGroup
  active     Boolean        @default(true)
  accounts   Account[]
  prices     LevelPrice[]
}

model Rep {
  id           Int               @id @default(autoincrement())
  otId         Int               @unique
  name         String
  active       Boolean           @default(true)
  commissioned Boolean           @default(false) // false = house
  email        String?           @unique
  accounts     Account[]
  orders       Order[]
  commissions  CommissionEntry[]
}

enum AccountStatus {
  PENDING
  ACTIVE
  ON_HOLD
  CLOSED
}

model Account {
  id             Int           @id @default(autoincrement())
  otCustomerId   Int?          @unique
  name           String
  customerType   String?
  priceLevelId   Int?
  priceLevel     PriceLevel?   @relation(fields: [priceLevelId], references: [id])
  repId          Int?
  rep            Rep?          @relation(fields: [repId], references: [id])
  terms          String?
  shipState      String? // normalized 2-letter code
  licenseNumber  String?
  licenseExpires DateTime?
  status         AccountStatus @default(PENDING)
  users          BuyerUser[]
  orders         Order[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum UserRole {
  BUYER
  VIEW_ONLY
  REP
  ADMIN
}

model BuyerUser {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String?
  role      UserRole  @default(BUYER)
  accountId Int?
  account   Account?  @relation(fields: [accountId], references: [id])
  repId     Int? // set for REP users
  invitedBy Int?
  lastLogin DateTime?
  createdAt DateTime  @default(now())
}

model MagicLink {
  id        Int       @id @default(autoincrement())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

enum Brand {
  HAZE
  TOTALLY_BAKED
}

model Product {
  id            Int          @id @default(autoincrement())
  otItemId      Int          @unique
  code          String // Order Time item name, e.g. "PR-S-20"
  sku           String?
  name          String // readable description shown to buyers
  category      String // Flower, Pre-Rolls, Vapes, Concentrates, Edibles, Bulk Flower
  brand         Brand
  isBulk        Boolean      @default(false)
  basePrice     Decimal      @db.Decimal(10, 2) // per unit; per lb for bulk flower
  msrp          Decimal?     @db.Decimal(10, 2)
  visible       Boolean      @default(true) // admin toggle
  active        Boolean      @default(true)
  blockedStates String[]     @default([])
  available     Decimal      @default(0) @db.Decimal(12, 3) // HQ available, base unit
  reorderPoint  Decimal?     @db.Decimal(12, 3)
  stockSyncedAt DateTime?
  // Photos: photoUrl is matched automatically from the brand Shopify stores each hour;
  // photoOverride is set by an admin (an image URL or /photos/<id> for an upload) and wins.
  photoUrl      String?
  photoSource   String? // sku | strain | line
  photoOverride String? // "none" hides the automatic photo
  prices        LevelPrice[]
  orderLines    OrderLine[]
  updatedAt     DateTime     @updatedAt
}

model LevelPrice {
  productId    Int
  priceLevelId Int
  price        Decimal    @db.Decimal(10, 2)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  priceLevel   PriceLevel @relation(fields: [priceLevelId], references: [id], onDelete: Cascade)

  @@id([productId, priceLevelId])
}

enum AnnouncementType {
  DEAL
  DELAY
  NEWS
}

model Announcement {
  id          Int              @id @default(autoincrement())
  type        AnnouncementType
  title       String
  body        String
  ctaLabel    String?
  ctaCategory String?
  audience    String           @default("all")
  pinned      Boolean          @default(false)
  live        Boolean          @default(true)
  endsAt      DateTime?
  emailed     Boolean          @default(false)
  createdAt   DateTime         @default(now())
}

enum PaymentMethod {
  CARD
  ACH_WIRE
}

enum OrderStatus {
  SUBMITTED // waiting on ACH/wire receipt or admin review
  APPROVED // posted to Order Time
  REJECTED
  CANCELLED
}

model Order {
  id             Int               @id @default(autoincrement())
  accountId      Int
  account        Account           @relation(fields: [accountId], references: [id])
  placedByUserId Int?
  repId          Int?
  rep            Rep?              @relation(fields: [repId], references: [id])
  paymentMethod  PaymentMethod
  status         OrderStatus       @default(SUBMITTED)
  customerPO     String?
  notes          String?
  subtotal       Decimal           @db.Decimal(12, 2)
  cardFee        Decimal           @default(0) @db.Decimal(12, 2)
  total          Decimal           @db.Decimal(12, 2)
  otSalesOrderNo Int?
  otPostedAt     DateTime?
  otError        String? // last error posting to Order Time; admins can retry
  paymentRef     String? // Authorize.net transaction ID
  cardLast4      String?
  paidAt         DateTime?
  approvedBy     String?
  shippedAt      DateTime?
  tracking       Json? // [{ carrier, service, number, url, shipDate }] from ShipStation
  shipCheckedAt  DateTime?
  shipEmailedAt  DateTime?
  lines          OrderLine[]
  commissions    CommissionEntry[]
  createdAt      DateTime          @default(now())
}

model OrderLine {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id])
  quantity  Decimal  @db.Decimal(12, 3)
  uom       String // "EA", "1/4LB", "1/2LB", "LB"
  pounds    Decimal? @db.Decimal(12, 3) // bulk flower only
  unitPrice Decimal  @db.Decimal(10, 2)
  lineTotal Decimal  @db.Decimal(12, 2)
}

enum CommissionState {
  PENDING
  EARNED
  PAID
  REVERSED
}

model CommissionEntry {
  id        Int             @id @default(autoincrement())
  orderId   Int?
  order     Order?          @relation(fields: [orderId], references: [id])
  repId     Int
  rep       Rep             @relation(fields: [repId], references: [id])
  rule      String
  basis     Decimal         @db.Decimal(12, 3) // $ subtotal or lbs
  amount    Decimal         @db.Decimal(12, 2)
  state     CommissionState @default(PENDING)
  note      String?
  payoutId  String?
  paidAt    DateTime?
  createdBy String?
  createdAt DateTime        @default(now())

  @@index([repId, state])
  @@index([payoutId])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actor     String
  action    String
  detail    Json?
  createdAt DateTime @default(now())
}

/**
 * Small admin-editable settings, e.g. ACH/wire instructions shown after checkout.
 */
model Setting {
  key       String   @id
  value     String
  updatedBy String?
  updatedAt DateTime @updatedAt
}

/**
 * Product photos uploaded by admins, served from /photos/<id>.
 */
model ProductPhoto {
  id        Int      @id @default(autoincrement())
  mime      String
  data      Bytes
  bytes     Int
  createdBy String?
  createdAt DateTime @default(now())
}
